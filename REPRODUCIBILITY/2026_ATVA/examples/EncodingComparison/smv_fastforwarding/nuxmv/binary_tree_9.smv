MODULE main
    VAR
        system : system_module;
--------------SPECIFICATIONS

LTLSPEC G(((system.AtMaxA.status = success) -> G((!((system.AtMaxA.status = failure)) & !((system.At0A.status = success)) & !((system.Dec.status = success)) & !((system.Dec.status = failure)) & !((system.Inc.status = success)) & !((system.Inc.status = failure))))));
CTLSPEC AG(((system.AtMaxA.status = success) -> AG((!((system.AtMaxA.status = failure)) & !((system.At0A.status = success)) & !((system.Dec.status = success)) & !((system.Dec.status = failure)) & !((system.Inc.status = success)) & !((system.Inc.status = failure))))));
INVARSPEC (system.vv_stage_0 < 512);

--------------END OF SPECIFICATIONS

