		AtV7.reset := active_node = -1;
		AtMaxB.active := active_node = node_names.AtMaxB;
		AtMaxB.reset := active_node = -1;
		Inc.active := active_node = node_names.Inc;
		Inc.reset := active_node = -1;
		--START OF BLACKBOARD DEFINITIONS
		--END OF BLACKBOARD DEFINITIONS
	VAR
		node_names : define_nodes;
		active_node : -1..23;
		At0A : At0A_module(vv);
		AtMaxA : AtMaxA_module(vv);
		Dec : Dec_module(rv);
		AtV0 : AtV0_module(vv);
		AtV1 : AtV1_module(vv);
		AtV2 : AtV2_module(vv);
		AtV3 : AtV3_module(vv);
		AtV4 : AtV4_module(vv);
		AtV5 : AtV5_module(vv);
		AtV6 : AtV6_module(vv);
		AtV7 : AtV7_module(vv);
		AtMaxB : AtMaxB_module(vv);
		Inc : Inc_module(rv);
		--START OF BLACKBOARD VARIABLES DECLARATION
		vv : 0..8;
		rv : boolean;
		--END OF BLACKBOARD VARIABLES DECLARATION
	ASSIGN
		init(active_node) := -1;
		--START OF BLACKBOARD VARIABLES INITIALIZATION
		init(vv) := 
			case
				TRUE : 0;
			esac;
		init(rv) := 
			case
				TRUE : FALSE;
			esac;
		--END OF BLACKBOARD VARIABLES INITIALIZATION
		next(active_node) :=
			case
				active_node = -1 & TRUE : node_names.Root;
				active_node = -1 & !(TRUE) : -1;
				(active_node = node_names.At0A) & (status__At0A != invalid) : node_names.SelDec;
				(active_node = node_names.AtMaxA) & (status__AtMaxA != invalid) : node_names.SelDec;
				(active_node = node_names.Dec) & (status__Dec != invalid) : node_names.SelDec;
				(active_node = node_names.SelDec) & (status__SelDec != invalid) : node_names.Root;
				(active_node = node_names.SelDec) & (status__SelDec = invalid) : next_child__SelDec;
				(active_node = node_names.AtV0) & (status__AtV0 != invalid) : node_names.Sel0;
				(active_node = node_names.AtV1) & (status__AtV1 != invalid) : node_names.Sel0;
				(active_node = node_names.Sel0) & (status__Sel0 != invalid) : node_names.Sel2;
				(active_node = node_names.Sel0) & (status__Sel0 = invalid) : next_child__Sel0;
				(active_node = node_names.AtV2) & (status__AtV2 != invalid) : node_names.Sel1;
				(active_node = node_names.AtV3) & (status__AtV3 != invalid) : node_names.Sel1;
				(active_node = node_names.Sel1) & (status__Sel1 != invalid) : node_names.Sel2;
				(active_node = node_names.Sel1) & (status__Sel1 = invalid) : next_child__Sel1;
				(active_node = node_names.Sel2) & (status__Sel2 != invalid) : node_names.Sel6;
				(active_node = node_names.Sel2) & (status__Sel2 = invalid) : next_child__Sel2;
				(active_node = node_names.AtV4) & (status__AtV4 != invalid) : node_names.Sel3;
				(active_node = node_names.AtV5) & (status__AtV5 != invalid) : node_names.Sel3;
				(active_node = node_names.Sel3) & (status__Sel3 != invalid) : node_names.Sel5;
				(active_node = node_names.Sel3) & (status__Sel3 = invalid) : next_child__Sel3;
				(active_node = node_names.AtV6) & (status__AtV6 != invalid) : node_names.Sel4;
				(active_node = node_names.AtV7) & (status__AtV7 != invalid) : node_names.Sel4;
				(active_node = node_names.Sel4) & (status__Sel4 != invalid) : node_names.Sel5;
				(active_node = node_names.Sel4) & (status__Sel4 = invalid) : next_child__Sel4;
				(active_node = node_names.Sel5) & (status__Sel5 != invalid) : node_names.Sel6;
				(active_node = node_names.Sel5) & (status__Sel5 = invalid) : next_child__Sel5;
				(active_node = node_names.Sel6) & (status__Sel6 != invalid) : node_names.Root;
				(active_node = node_names.Sel6) & (status__Sel6 = invalid) : next_child__Sel6;
				(active_node = node_names.AtMaxB) & (status__AtMaxB != invalid) : node_names.SelInc;
				(active_node = node_names.Inc) & (status__Inc != invalid) : node_names.SelInc;
				(active_node = node_names.SelInc) & (status__SelInc != invalid) : node_names.Root;
				(active_node = node_names.SelInc) & (status__SelInc = invalid) : next_child__SelInc;
				(active_node = node_names.Root) & (status__Root != invalid) : -1;
				(active_node = node_names.Root) & (status__Root = invalid) : next_child__Root;
				TRUE : active_node;
			esac;
		--START OF BLACKBOARD VARIABLES TRANSITION
		next(vv) :=
			case
				(active_node = node_names.Dec) & (rv) : vv;
				(active_node = node_names.Dec) & (TRUE) : max(0, (vv - 1));
				(active_node = node_names.Inc) & (rv) : min(8, (vv + 1));
				(active_node = node_names.Inc) & (TRUE) : vv;
				TRUE : vv;
			esac;
		next(rv) :=
			case
				(active_node = node_names.Dec) & (TRUE) : {TRUE, FALSE};
				(active_node = node_names.Inc) & (TRUE) : {TRUE, FALSE};
				TRUE : rv;
			esac;
		--END OF BLACKBOARD VARIABLES TRANSITION

LTLSPEC G(((AtMaxA.status = success) -> G((!((AtMaxA.status = failure)) & !((At0A.status = success)) & !((Dec.status = success)) & !((Dec.status = failure)) & !((Inc.status = success)) & !((Inc.status = failure))))));
CTLSPEC AG(((AtMaxA.status = success) -> AG((!((AtMaxA.status = failure)) & !((At0A.status = success)) & !((Dec.status = success)) & !((Dec.status = failure)) & !((Inc.status = success)) & !((Inc.status = failure))))));
INVARSPEC (vv < 8);
MODULE define_nodes
	DEFINE
		Root := 0;
		SelDec := 1;
		At0A := 2;
		AtMaxA := 3;
		Dec := 4;
		Sel6 := 5;
		Sel2 := 6;
		Sel0 := 7;
		AtV0 := 8;
		AtV1 := 9;
		Sel1 := 10;
		AtV2 := 11;
		AtV3 := 12;
		Sel5 := 13;
		Sel3 := 14;
		AtV4 := 15;
		AtV5 := 16;
		Sel4 := 17;
		AtV6 := 18;
		AtV7 := 19;
		SelInc := 20;
		AtMaxB := 21;
		Inc := 22;
MODULE At0A_module(vv)
    CONSTANTS
        success, failure, running, invalid;
    DEFINE
        status :=
            case
                reset : invalid;
                !(active) : previous_status;
                (vv = 0) : success;
                TRUE : failure;
            esac;
    VAR
        previous_status : {invalid, success, failure};
    ASSIGN
        init(previous_status) := invalid;
        next(previous_status) := status;
MODULE AtMaxA_module(vv)
    CONSTANTS
