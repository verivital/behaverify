		status__AtV2 := AtV2.status;
		status__AtV3 := AtV3.status;
		status__Sel1 := 
			case
				status__AtV2 != failure : status__AtV2;
				status__AtV3 != failure : status__AtV3;
				TRUE : failure;
			esac;
		status__Sel2 := 
			case
				status__Sel0 != failure : status__Sel0;
				status__Sel1 != failure : status__Sel1;
				TRUE : failure;
			esac;
		status__AtV4 := AtV4.status;
		status__AtV5 := AtV5.status;
		status__Sel3 := 
			case
				status__AtV4 != failure : status__AtV4;
				status__AtV5 != failure : status__AtV5;
				TRUE : failure;
			esac;
		status__AtV6 := AtV6.status;
		status__AtV7 := AtV7.status;
		status__Sel4 := 
			case
				status__AtV6 != failure : status__AtV6;
				status__AtV7 != failure : status__AtV7;
				TRUE : failure;
			esac;
		status__Sel5 := 
			case
				status__Sel3 != failure : status__Sel3;
				status__Sel4 != failure : status__Sel4;
				TRUE : failure;
			esac;
		status__Sel6 := 
			case
				status__Sel2 != failure : status__Sel2;
				status__Sel5 != failure : status__Sel5;
				TRUE : failure;
			esac;
		status__AtMaxB := AtMaxB.status;
		status__Inc := Inc.status;
		status__SelInc := 
			case
				status__AtMaxB != failure : status__AtMaxB;
				status__Inc != failure : status__Inc;
				TRUE : failure;
			esac;
		status__Root := 
			case
				status__SelDec != success : status__SelDec;
				status__Sel6 != success : status__Sel6;
				status__SelInc != success : status__SelInc;
				TRUE : success;
			esac;
		next_child__SelDec := 
			case
				(status__At0A = invalid)& (child_index_to_resume_from__SelDec <= 0) : node_names.At0A;
				(status__AtMaxA = invalid)& (child_index_to_resume_from__SelDec <= 1) : node_names.AtMaxA;
				(status__Dec = invalid)& (child_index_to_resume_from__SelDec <= 2) : node_names.Dec;
			esac;
		next_child__Sel0 := 
			case
				(status__AtV0 = invalid)& (child_index_to_resume_from__Sel0 <= 0) : node_names.AtV0;
				(status__AtV1 = invalid)& (child_index_to_resume_from__Sel0 <= 1) : node_names.AtV1;
			esac;
		next_child__Sel1 := 
