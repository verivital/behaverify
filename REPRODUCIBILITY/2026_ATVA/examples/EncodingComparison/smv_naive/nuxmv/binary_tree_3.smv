				(status__Sel0 = invalid)& (child_index_to_resume_from__Sel2 <= 0) : node_names.Sel0;
				(status__Sel1 = invalid)& (child_index_to_resume_from__Sel2 <= 1) : node_names.Sel1;
			esac;
		next_child__Sel3 := 
