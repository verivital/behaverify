				(status__AtV6 = invalid)& (child_index_to_resume_from__Sel4 <= 0) : node_names.AtV6;
				(status__AtV7 = invalid)& (child_index_to_resume_from__Sel4 <= 1) : node_names.AtV7;
			esac;
		next_child__Sel5 := 
			case
				(status__Sel3 = invalid)& (child_index_to_resume_from__Sel5 <= 0) : node_names.Sel3;
				(status__Sel4 = invalid)& (child_index_to_resume_from__Sel5 <= 1) : node_names.Sel4;
