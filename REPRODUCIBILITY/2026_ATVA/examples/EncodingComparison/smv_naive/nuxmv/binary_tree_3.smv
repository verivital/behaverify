			esac;
		next_child__Root := 
			case
				(status__SelDec = invalid)& (child_index_to_resume_from__Root <= 0) : node_names.SelDec;
				(status__Sel6 = invalid)& (child_index_to_resume_from__Root <= 1) : node_names.Sel6;
				(status__SelInc = invalid)& (child_index_to_resume_from__Root <= 2) : node_names.SelInc;
			esac;
		At0A.active := active_node = node_names.At0A;
		At0A.reset := active_node = -1;
		AtMaxA.active := active_node = node_names.AtMaxA;
		AtMaxA.reset := active_node = -1;
		Dec.active := active_node = node_names.Dec;
		Dec.reset := active_node = -1;
		AtV0.active := active_node = node_names.AtV0;
