FROM ubuntu:24.04
RUN apt-get update -y
RUN apt-get upgrade -y

# Set the non-root user information
ARG VENUE=2026_ATVA
ARG USER=BehaVerify_$VENUE
ARG UID=22238
ARG GID=22238

# Create a non-root user
RUN groupadd -g $GID $USER \
    && useradd -u $UID -g $GID -m -s /bin/bash $USER

# Give sudo privileges to the non-root user
RUN apt-get update && apt-get install -y sudo \
    && echo "$USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USER \
    && chmod 0440 /etc/sudoers.d/$USER

WORKDIR /home/$USER
USER $USER

RUN sudo apt-get install wget git python3 pip python3-venv python3-tk -y
RUN sudo apt-get install graphviz -y

# Install behaverify from local frozen source (gives us -m behaverify with --use_encoding support)
RUN mkdir -p /home/$USER/behaverify
COPY --chown=$USER:$USER pyproject.toml /home/$USER/behaverify/pyproject.toml
COPY --chown=$USER:$USER src /home/$USER/behaverify/src

RUN python3 -m venv /home/$USER/python_venvs/behaverify
RUN /home/$USER/python_venvs/behaverify/bin/python3 -m pip install --upgrade pip
RUN /home/$USER/python_venvs/behaverify/bin/python3 -m pip install -e /home/$USER/behaverify

# Copy REPRODUCIBILITY folder and install remaining dependencies
COPY --chown=$USER:$USER REPRODUCIBILITY/$VENUE /home/$USER/behaverify/REPRODUCIBILITY/$VENUE
RUN /home/$USER/python_venvs/behaverify/bin/python3 -m pip install -r /home/$USER/behaverify/REPRODUCIBILITY/$VENUE/requirements/core.txt

# Copy nuXmv binary
COPY --chown=$USER:$USER REPRODUCIBILITY/$VENUE/nuXmv /home/$USER/behaverify/REPRODUCIBILITY/$VENUE/nuXmv
RUN chmod +x /home/$USER/behaverify/REPRODUCIBILITY/$VENUE/nuXmv

WORKDIR /home/$USER/behaverify/REPRODUCIBILITY/$VENUE

CMD ["/bin/bash", "-c", "./BehaVerify_2026_ATVA.sh ./"]
